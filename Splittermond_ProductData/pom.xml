<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.prelle.rpgframework</groupId>
    <artifactId>splittermond-all</artifactId>
    <version>4.0.0-SNAPSHOT</version>
  </parent>

	<artifactId>splittermond-productdata</artifactId>
	<name>Splittermond ProductData</name>
	<description>Adventure modules released for Splittermond</description>

	<properties>
		<maven.install.skip>true</maven.install.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<dependencies>
		<dependency>
			<groupId>de.rpgframework</groupId>
			<artifactId>babylon</artifactId>
			<version>3.0.0</version>
		</dependency>
		<dependency>
			<groupId>de.rpgframework</groupId>
			<artifactId>babylon-charrules</artifactId>
			<version>3.0.0</version>
		</dependency>
		<dependency>
			<groupId>de.rpgframework</groupId>
			<artifactId>rpgframework-api</artifactId>
			<version>[3.0.0-SNAPSHOT,3.99.99)</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
      <!-- Packaging -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.1.1</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              <useUniqueVersions>false</useUniqueVersions>
              <packageName>SPLITTERMOND</packageName>
            </manifest>
            <manifestEntries>
              <UUID>7ea06303-dc70-414a-926d-18c17556c26c</UUID>
              <Implementation-Vendor>Stefan Prelle</Implementation-Vendor>
              <State>ACTIVE</State>
              <Build-Time>${maven.build.timestamp}</Build-Time>
              <MinVersion>4.0.0-SNAPSHOT</MinVersion>
              <MaxVersion>4.99.99</MaxVersion>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

			<plugin>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>scp</id>
						<phase>deploy</phase>
						<configuration>
							<tasks>
								<scp
									todir="${BB_USER_TOKEN}:${BB_PWD_TOKEN}@${deploymentServer}:${deploymentPath}"
									sftp="true" failonerror="true" trust="true" verbose="true">
									<fileset dir="target">
										<include name="*.jar" />
									</fileset>
								</scp>
							</tasks>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>org.apache.ant</groupId>
						<artifactId>ant-jsch</artifactId>
						<version>1.9.4</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>
</project>
