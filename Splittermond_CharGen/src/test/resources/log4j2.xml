<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="info">
    <Appenders>
        <RollingFile name="fileLogger" fileName="./logs/genesis-log.txt" filePattern="./logs/genesis-log.txt_%d{yyyyMMdd}.log.gz">
            <PatternLayout>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%c] (%F:%L) - %m%n</pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
            </Policies>
        </RollingFile>

        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout   pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%c] (%F:%L) - %m%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="xml" level="warn" />
        <Logger name="babylon.chars" level="warn" />
        <Logger name="babylon.products" level="info" />
        <Logger name="splittermond.jfx" level="debug" />
        <Logger name="rpgframework.jfx" level="debug" />
        <Logger name="prelle.jfx" level="debug" />
        <Logger name="genesis" level="debug" />
        <Root level="info" additivity="false">
            <appender-ref ref="console" />
            <appender-ref ref="fileLogger" />
        </Root>
    </Loggers>
</Configuration>