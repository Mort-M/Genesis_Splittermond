<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.prelle.rpgframework</groupId>
		<artifactId>splittermond-all</artifactId>
		<version>4.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>splittermond-json</artifactId>
	<name>Splittermond JSON Export</name>
	<description>Splittermond export to JSON</description>
	<version>1.2.0-SNAPSHOT</version>

	<properties>
		<maven.install.skip>true</maven.install.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<developers>
		<developer>
			<name>Anja Prelle</name>
			<email>anja@rpgframework.de</email>
			<timezone>GMT+1</timezone>
			<roles>
				<role>Lead developer</role>
			</roles>
		</developer>
		<developer>
			<name>Stefan Prelle</name>
			<email>stefan@rpgframework.de</email>
			<timezone>GMT+1</timezone>
			<roles>
				<role>Maintainer</role>
			</roles>
		</developer>
	</developers>

	<dependencies>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>de.rpgframework</groupId>
			<artifactId>rpgframework-core</artifactId>
		</dependency>
		<dependency>
			<groupId>de.rpgframework</groupId>
			<artifactId>rpgframework-print</artifactId>
		</dependency>
		<dependency>
			<groupId>org.prelle.rpgframework</groupId>
			<artifactId>splittermond-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.prelle.rpgframework</groupId>
			<artifactId>splittermond-data</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.prelle.rpgframework</groupId>
			<artifactId>babylon-licensecheck</artifactId>
			<version>[3.0.0-SNAPSHOT,3.99.99)</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>[4.12,)</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>

			<!-- Packaging -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.1.1</version>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							<useUniqueVersions>false</useUniqueVersions>
							<packageName>SPLITTERMOND</packageName>
						</manifest>
						<manifestEntries>
							<UUID>01a83173-eac2-482a-9b2d-fffe3be45258</UUID>
							<Bugtracker>https://rpgframework.atlassian.net/servicedesk/customer/portals</Bugtracker>
							<State>STABLE</State>
							<Build-Time>${maven.build.timestamp}</Build-Time>
							<MinVersion>4.1.0-SNAPSHOT</MinVersion>
							<MaxVersion>4.99.99</MaxVersion>
							<Requires>CORE</Requires>
							<Provides>JSON</Provides>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>

			<plugin>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>scp</id>
						<phase>deploy</phase>
						<configuration>
							<tasks>
								<echo message="Unpack manifest from jar" />
								<unzip
									src="target/${project.artifactId}-${project.version}.jar"
									dest="target">
									<patternset>
										<include name="META-INF/MANIFEST.MF" />
									</patternset>
								</unzip>
								<copy file="target/META-INF/MANIFEST.MF"
									tofile="target/${project.artifactId}-${project.version}.mf" />

								<echo
									message="Copy plugin descriptor ${project.artifactId}-${project.version}.mf to ${deploymentServer}:${deploymentPath}" />
								<scp
									todir="${BB_USER_TOKEN}:${BB_PWD_TOKEN}@${deploymentServer}:${deploymentPath}/"
									sftp="true" failonerror="false" trust="true" verbose="false">
									<fileset dir="target">
										<include
											name="${project.artifactId}-${project.version}.mf" />
									</fileset>
								</scp>
								<echo
									message="Copy plugin to ${deploymentServer}:${deploymentPath}" />
								<scp
									todir="${BB_USER_TOKEN}:${BB_PWD_TOKEN}@${deploymentServer}:${deploymentPath}"
									sftp="true" failonerror="false" trust="true" verbose="false">
									<fileset dir="target">
										<include
											name="${project.artifactId}-${project.version}.jar" />
									</fileset>
								</scp>
							</tasks>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>org.apache.ant</groupId>
						<artifactId>ant-jsch</artifactId>
						<version>1.9.4</version>
					</dependency>
				</dependencies>
			</plugin>

		</plugins>
	</build>
</project>
