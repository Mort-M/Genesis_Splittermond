<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<educations>
	
	<education id="swamppilot" variantof="scout">
        <modifications>
            <!-- Sumpflotse ist ein Kundschafter, kein Entdecker. Im Forum bestätigt https://forum.splittermond.de/index.php?topic=6493.0 -->
            <powermod ref="swift"/>
            <powermod ref="senseorient"/>

            <selmod dist="2">
                <resourcemod ref="creature"/>
                <resourcemod ref="relic"/>
            </selmod>
            
            <selmod num="1">
                <skillmod ref="slashing" value="1"/>
                <skillmod ref="melee" value="1"/>
                <skillmod ref="chains" value="1"/>
                <skillmod ref="blades" value="1"/>
                <skillmod ref="staffs" value="1"/>
            </selmod>
            <selmod num="1">
                <skillmod ref="longrange" value="3"/>
                <skillmod ref="throwing" value="3"/>
            </selmod>
            <skillmod ref="athletics" value="3"/>
            <selmod num="1">
                <skillmod ref="craftmanship" value="2"/>
                <skillmod ref="countrylore" value="2"/>
            </selmod>
            <skillmod ref="stealth" value="3"/>
            <skillmod ref="hunting" value="1"/>
            <skillmod ref="nature" value="3"/>
            <skillmod ref="swim" value="3"/>
            <skillmod ref="survival" value="3"/>
            <skillmod ref="perception" value="3"/>
            <skillmod ref="seafaring" value="3"/>
            <selmod num="1">
                <skillmod ref="endurance" value="2"/>
                <skillmod ref="naturemagic" value="2"/>
                <skillmod ref="watermagic" value="2"/>
            </selmod>
            
            <mastermod spec="stealth/naturalenvironment"/>
            <selmod num="1">
                <mastermod spec="perception/hear"/>
                <mastermod spec="perception/see"/>
            </selmod>           
        </modifications>
    </education>

	<education id="hatangabi_chainwarrior" variantof="fighter">
        <modifications>
            <reqmod type="culture" ref="pirate_bawalin"/>
            
            <powermod ref="sturdy"/>
            
            <selmod dist="2">
                <resourcemod ref="entourage"/>
                <resourcemod ref="mentor"/>
                <resourcemod ref="rank"/>
            </selmod>
            
            <selmod values="3 3">
                <skillmod ref="slashing" />
                <skillmod ref="melee" />
                <skillmod ref="blades" />
                <skillmod ref="staffs" />
                <skillmod ref="longrange" />
                <skillmod ref="throwing" />
            </selmod>
            <skillmod ref="chains" value="3"/>
            <skillmod ref="acrobatics" value="2"/>
            <skillmod ref="seafaring" value="2"/>
            <skillmod ref="swim" value="2"/>
            <selmod num="1">
                <skillmod ref="leadership" value="1"/>
                <skillmod ref="animals" value="1"/>
            </selmod>
            <skillmod ref="athletics" value="3"/>
            <skillmod ref="determination" value="3"/>
            <selmod num="1">
                <skillmod ref="heal" value="2"/>
                <skillmod ref="enhancemagic" value="2"/>
            </selmod>
            <skillmod ref="survival" value="1"/>
            <skillmod ref="perception" value="2"/>
            <skillmod ref="endurance" value="3"/>

            <mastermod ref="chains/berserk"/>
            <mastermod skilltype="COMBAT" level="1"/>

        </modifications>
    </education>

