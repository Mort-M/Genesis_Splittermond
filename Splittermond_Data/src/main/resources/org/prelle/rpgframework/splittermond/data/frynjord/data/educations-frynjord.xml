<educations>
	<!-- Pflanzenkünstler (Verwandlers) -->
	<education id="plantartists" variantof="transformer">
		<modifications>
            <reqmod type="culture" ref="frynjord"/>	

               <selmod>
                   <powermod ref="focuspool"/>
                   <powermod ref="focusregen"/>
               </selmod>
               <selmod>
                   <resourcemod ref="reputation" value="1"/>
                   <resourcemod ref="status" value="1"/>
               </selmod>
               <selmod>
                   <resourcemod ref="relic" value="1"/>
                   <resourcemod ref="wealth" value="1"/>
                   <resourcemod ref="refuge" value="1"/>                  
               </selmod>
               <skillmod ref="alchemy" value="3"/>
               <skillmod ref="arcanelore" value="3"/>
               <skillmod ref="empathy" value="1"/>
               <skillmod ref="determination" value="2"/>
               <skillmod ref="history" value="3"/>
