	<!-- Hyelfryn (Mystischen Kriegers) -->
	<education id="hyelfryn" variantof="mysticwarrior">
        <modifications>
            <reqmod type="culture" ref="frynjord"/>	
            
            <selmod>
                <powermod ref="focuspool"/>
                <powermod ref="liferegen"/>
            </selmod>
            <selmod>
                <resourcemod ref="reputation" value="1"/>
