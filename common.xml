<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>de.rpgframework</groupId>
		<artifactId>rpgframework-common</artifactId>
		<version>1.0</version>
	</parent>

	<groupId>de.rpgframework</groupId>
	<artifactId>splittermond-common</artifactId>
	<version>1.0</version>
	<name>Splittermond Common Definitions</name>
	<packaging>pom</packaging>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>wagon-maven-plugin</artifactId>
				<version>1.0</version>
				<executions>
					<execution>
						<id>upload-to-myserver</id>
						<phase>deploy</phase>
						<goals>
							<goal>upload-single</goal>
						</goals>
						<configuration>
							<serverId>updates</serverId>
							<fromFile>releasenotes.html</fromFile>
							<toFile>${project.artifactId}-${project.version}.jar.html</toFile>
							<url>scp://updates.rpgframework.de/var/www/html/release-notes/</url>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>log4j</groupId>
				<artifactId>log4j</artifactId>
				<version>1.2.17</version>
			</dependency>
			<dependency>
				<groupId>junit</groupId>
				<artifactId>junit</artifactId>
				<version>[4.12,)</version>
				<scope>test</scope>
			</dependency>

			<dependency>
				<groupId>org.prelle</groupId>
				<artifactId>javafx-extensions</artifactId>
				<version>[2.0-SNAPSHOT,)</version>
			</dependency>
			<dependency>
				<groupId>org.prelle</groupId>
				<artifactId>simple-persist</artifactId>
				<version>[1.3-SNAPSHOT,)</version>
			</dependency>
			<dependency>
				<groupId>de.rpgframework</groupId>
				<artifactId>rpgframework-api</artifactId>
				<version>[1.3-SNAPSHOT,)</version>
			</dependency>
			<dependency>
				<groupId>de.rpgframework</groupId>
				<artifactId>rpgframework-api-jfx</artifactId>
				<version>[1.3-SNAPSHOT,)</version>
			</dependency>
			<dependency>
				<groupId>de.rpgframework</groupId>
				<artifactId>rpgframework-jfx</artifactId>
				<version>[1.3-SNAPSHOT,)</version>
			</dependency>
			<dependency>
				<groupId>org.prelle.rpgframework</groupId>
				<artifactId>splittermond-core</artifactId>
				<version>[2.7.0,)</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
